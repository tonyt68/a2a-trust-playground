[
  {
    "name": "empty object",
    "source": "RFC 8785",
    "value": {},
    "expected": "{}"
  },
  {
    "name": "empty array value",
    "source": "RFC 8785",
    "value": {
      "a": []
    },
    "expected": "{\"a\":[]}"
  },
  {
    "name": "keys sorted, not insertion order",
    "source": "RFC 8785",
    "value": {
      "b": 2,
      "a": 1
    },
    "expected": "{\"a\":1,\"b\":2}"
  },
  {
    "name": "array order is preserved, never sorted",
    "source": "RFC 8785",
    "value": {
      "a": [
        3,
        1,
        2
      ]
    },
    "expected": "{\"a\":[3,1,2]}"
  },
  {
    "name": "null and booleans",
    "source": "RFC 8785",
    "value": {
      "n": null,
      "t": true,
      "f": false
    },
    "expected": "{\"f\":false,\"n\":null,\"t\":true}"
  },
  {
    "name": "integers including zero and negative",
    "source": "RFC 8785",
    "value": {
      "z": 0,
      "n": -17,
      "p": 42
    },
    "expected": "{\"n\":-17,\"p\":42,\"z\":0}"
  },
  {
    "name": "non-ASCII in a value stays raw UTF-8",
    "source": "RFC 8785",
    "value": {
      "k": "café"
    },
    "expected": "{\"k\":\"café\"}"
  },
  {
    "name": "non-ASCII in a key stays raw UTF-8",
    "source": "RFC 8785",
    "value": {
      "é": 1
    },
    "expected": "{\"é\":1}"
  },
  {
    "name": "only JSON-mandated escapes",
    "source": "RFC 8785",
    "value": {
      "q": "a\"b\\c"
    },
    "expected": "{\"q\":\"a\\\"b\\\\c\"}"
  },
  {
    "name": "control characters use the short escapes",
    "source": "RFC 8785",
    "value": {
      "c": "\t\n\r"
    },
    "expected": "{\"c\":\"\\t\\n\\r\"}"
  },
  {
    "name": "other control characters use \\u form",
    "source": "RFC 8785",
    "value": {
      "c": "\u0001"
    },
    "expected": "{\"c\":\"\\u0001\"}"
  },
  {
    "name": "forward slash is not escaped",
    "source": "RFC 8785",
    "value": {
      "u": "a/b"
    },
    "expected": "{\"u\":\"a/b\"}"
  },
  {
    "name": "BMP key ordering",
    "source": "RFC 8785",
    "value": {
      "€": 1,
      "$": 2,
      "¢": 3
    },
    "expected": "{\"$\":2,\"¢\":3,\"€\":1}"
  },
  {
    "name": "astral key ordering is by UTF-16 code unit",
    "source": "RFC 8785",
    "value": {
      "🔐": 1,
      "�": 2
    },
    "expected": "{\"🔐\":1,\"�\":2}"
  },
  {
    "name": "nested object and array",
    "source": "RFC 8785",
    "value": {
      "o": {
        "b": 1,
        "a": 2
      },
      "l": [
        1,
        {
          "d": 4,
          "c": 3
        }
      ]
    },
    "expected": "{\"l\":[1,{\"c\":3,\"d\":4}],\"o\":{\"a\":2,\"b\":1}}"
  },
